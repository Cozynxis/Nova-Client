<Window x:Class="NovaClient.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Nova Client" Width="1220" Height="760" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}" Foreground="White">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,14"/><Setter Property="BorderBrush" Value="#242A37"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Storyboard x:Key="PageIn"><DoubleAnimation Storyboard.TargetName="PageHost" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/><ThicknessAnimation Storyboard.TargetName="PageHost" Storyboard.TargetProperty="Margin" From="0,10,0,-10" To="0" Duration="0:0:0.22"/></Storyboard>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#0E1118" BorderBrush="#202633" BorderThickness="0,0,1,0">
      <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="6,8,0,30"><Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentBrush}"><TextBlock Text="N" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0,0,0"><TextBlock Text="NOVA" FontWeight="Bold" FontSize="17"/><TextBlock Text="CLIENT  ·  PREVIEW" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel>
        <StackPanel Grid.Row="1"><Button Style="{StaticResource NavButton}" Content="⌂   Home" Tag="Home" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="▣   Library" Tag="Library" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="✦   Discover" Tag="Discover" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⇩   Downloads" Tag="Downloads" Click="Nav_Click"/><Separator Margin="8,12" Background="#252B38"/><Button Style="{StaticResource NavButton}" Content="♙   Account" Tag="Account" Click="Nav_Click"/><Button Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Nav_Click"/></StackPanel>
        <Border Grid.Row="2" Background="#151A24" CornerRadius="12" Padding="12"><StackPanel><TextBlock Text="Nova Client v0.1" FontWeight="SemiBold"/><TextBlock Text="Early test build" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#202633" BorderThickness="0,0,0,1" Padding="28,0"><Grid><TextBlock x:Name="PageTitle" Text="Home" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Style="{StaticResource PrimaryButton}" Content="▶  PLAY" Click="Play_Click"/></StackPanel></Grid></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid x:Name="PageHost" Margin="28"><Grid x:Name="HomePage"><StackPanel><TextBlock Text="Good evening." FontSize="34" FontWeight="Bold"/><TextBlock Text="Everything you need for modded Minecraft, in one place." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,5,0,26"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Background="#171329"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="CURRENT PROFILE" Foreground="#B8A7FF" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="CurrentProfileName" Text="Performance" FontSize="29" FontWeight="Bold" Margin="0,12,0,3"/><TextBlock x:Name="CurrentProfileMeta" Text="Minecraft 1.21.1 • Fabric • 6 GB RAM" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Fast launch, isolated mods, separate configs and saves." Foreground="#C7CADA" Margin="0,18,0,0"/></StackPanel><Button Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="▶  Launch profile" HorizontalAlignment="Left" Margin="0,24,0,0" Click="Play_Click"/></Grid></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Quick stats" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ProfileCountText" Text="0 profiles" FontSize="27" FontWeight="Bold" Margin="0,18,0,0"/><TextBlock Text="Local, separated instances" Foreground="{StaticResource MutedBrush}"/><Separator Margin="0,18" Background="#2A3040"/><TextBlock Text="Modrinth" FontWeight="SemiBold"/><TextBlock Text="Connected to live search API" Foreground="#7FE1A1" Margin="0,4,0,0"/></StackPanel></Border></Grid><TextBlock Text="What’s new" FontSize="19" FontWeight="SemiBold" Margin="0,18,0,12"/><WrapPanel><Border Style="{StaticResource Card}" Width="290"><StackPanel><TextBlock Text="⚡ One-click mods" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Search compatible Modrinth mods and install straight into a profile." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Width="290"><StackPanel><TextBlock Text="◫ Isolated profiles" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Each profile gets its own folders, loader choice, memory and mods." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border></WrapPanel></StackPanel></Grid>
      <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Your library" FontSize="32" FontWeight="Bold"/><TextBlock Text="Create separate Minecraft environments for every setup." Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="＋  New profile" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewProfile_Click"/></Grid><ListBox x:Name="ProfilesList" Grid.Row="1" Margin="0,24,0,0" Background="Transparent" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Width="760"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="›" FontSize="28" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <Grid x:Name="DiscoverPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Discover mods" FontSize="32" FontWeight="Bold"/><TextBlock Text="Live results from Modrinth, filtered for your selected profile." Foreground="{StaticResource MutedBrush}"/></StackPanel><Grid Grid.Row="1" Margin="0,22,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" Height="42" Text="sodium" KeyDown="SearchBox_KeyDown"/><ComboBox x:Name="DiscoverVersion" Grid.Column="1" Margin="10,0" SelectedIndex="0"><ComboBoxItem Content="1.21.1"/><ComboBoxItem Content="1.21"/><ComboBoxItem Content="1.20.1"/></ComboBox><Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Search" Click="Search_Click"/></Grid><ListBox x:Name="ModsList" Grid.Row="2" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" MaxWidth="620" Margin="0,5,0,0"/><TextBlock Text="{Binding DownloadText}" Foreground="#B9A9FF" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Install" Tag="{Binding}" Click="InstallMod_Click" VerticalAlignment="Center" Margin="18,0,0,0"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <Grid x:Name="DownloadsPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Downloads" FontSize="32" FontWeight="Bold"/><TextBlock Text="Current downloads and recent installs appear here." Foreground="{StaticResource MutedBrush}"/><Border Style="{StaticResource Card}" Margin="0,25,0,0"><StackPanel><TextBlock x:Name="DownloadTitle" Text="No active downloads" FontSize="17" FontWeight="SemiBold"/><ProgressBar x:Name="DownloadProgress" Height="7" Margin="0,16,0,0" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="DownloadDetail" Text="Install a mod from Discover to start." Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/></StackPanel></Border></StackPanel></Grid>
      <Grid x:Name="AccountPage" Visibility="Collapsed"><StackPanel MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Minecraft account" FontSize="32" FontWeight="Bold"/><TextBlock Text="Nova uses Microsoft’s device-code OAuth flow. Your Microsoft password is never entered into Nova." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="AccountState" Text="Not connected" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Sign in with Microsoft to prepare Minecraft authentication." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/><Button Style="{StaticResource PrimaryButton}" Content="Sign in with Microsoft" HorizontalAlignment="Left" Click="MicrosoftLogin_Click"/><TextBlock x:Name="DeviceCodeText" Text="" Foreground="#C9BFFF" FontSize="15" Margin="0,16,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Grid>
      <Grid x:Name="SettingsPage" Visibility="Collapsed"><StackPanel MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Settings" FontSize="32" FontWeight="Bold"/><TextBlock Text="Tune Nova to your PC." Foreground="{StaticResource MutedBrush}"/><Border Style="{StaticResource Card}" Margin="0,24,0,0"><StackPanel><TextBlock Text="Default memory" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MemoryLabel" Text="6 GB" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,8"/><Slider x:Name="MemorySlider" Minimum="2" Maximum="16" Value="6" TickFrequency="1" ValueChanged="MemorySlider_ValueChanged"/><TextBlock Text="Appearance" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,4"/><TextBlock Text="Dark Nova theme • Windows 11-inspired surfaces • reduced visual clutter" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="Data directory" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,4"/><TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></StackPanel></Border></StackPanel></Grid>
      </Grid></ScrollViewer>
    </Grid>
  </Grid>
</Window>
